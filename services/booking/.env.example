DATABASE_URL=postgres://user:password@localhost:5433/homeshr?sslmode=disable
REDIS_URL=redis://default:password@localhost:6378

# gRPC server listen address (Envoy's upstream).
GRPC_PORT=:50052

# JWT signing secret (HS256). Must match the user service's JWT_SECRET and the
# base64url `k` in envoy.yaml's JWKS. Recompute after changing:
#   printf '%s' "$JWT_SECRET" | basenc --base64url | tr -d '='
JWT_SECRET=my_super_secret_key_123456789
